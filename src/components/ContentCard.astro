---
import MetadataList from "./MetadataList.astro";

interface Props {
  href: string;
  title: string;
  summary: string;
  date?: Date;
  tags?: string[];
  meta?: string;
}

const { href, title, summary, date, tags = [], meta } = Astro.props;
---

<article class="content-card">
  {meta && <p class="content-card__meta">{meta}</p>}
  <h2><a href={href}>{title}</a></h2>
  <p>{summary}</p>
  {(date || tags.length > 0) && <MetadataList date={date} tags={tags} />}
</article>
