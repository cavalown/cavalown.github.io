---
import { socialLinks } from "@data/site";
---

<nav class="hero__links" aria-label="External links">
  {
    socialLinks.map((link) => (
      <a
        href={link.href}
        target="_blank"
        rel="noreferrer"
        aria-label={link.label}
        title={link.label}
      >
        {
          link.label === "GitHub" ? (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.52 2.87 8.35 6.84 9.71.5.1.68-.22.68-.49 0-.24-.01-.88-.01-1.73-2.78.62-3.37-1.37-3.37-1.37-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.37-2.22-.26-4.55-1.14-4.55-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05A9.32 9.32 0 0 1 12 6.96c.85 0 1.7.12 2.5.35 1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.06.36.32.68.95.68 1.91 0 1.38-.01 2.49-.01 2.83 0 .27.18.59.69.49A10.12 10.12 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z" />
            </svg>
          ) : (
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M6.94 8.95H3.76V20h3.18V8.95ZM7.22 5.53C7.2 4.59 6.53 3.88 5.45 3.88c-1.07 0-1.78.71-1.78 1.65 0 .92.68 1.65 1.74 1.65h.02c1.1 0 1.79-.73 1.79-1.65ZM20.33 13.67c0-3.33-1.78-4.88-4.15-4.88-1.91 0-2.77 1.05-3.25 1.79V8.95H9.75c.04 1.04 0 11.05 0 11.05h3.18v-6.17c0-.33.02-.66.12-.89.26-.66.86-1.34 1.86-1.34 1.31 0 1.84 1 1.84 2.47V20h3.18l.4-6.33Z" />
            </svg>
          )
        }
      </a>
    ))
