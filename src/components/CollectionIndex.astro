---
import ContentCard from "@components/ContentCard.astro";
import { getEntryTags, type EntryCollection, type LocalizedEntry } from "@data/content";
import { copy, type Locale, withLocale } from "@data/i18n";
import BaseLayout from "@layouts/BaseLayout.astro";
import SectionHeader from "@components/SectionHeader.astro";

interface Props {
  collection: EntryCollection;
  entries: LocalizedEntry[];
  locale: Locale;
}

const { collection, entries, locale } = Astro.props;
const sectionCopy = copy[locale].sections[collection];
const label = copy[locale].nav[collection];
const gridClass =
  collection === "projects" ? "content-grid" : "content-grid content-grid--articles";
const tagCounts = entries
  .flatMap((entry) => getEntryTags(entry))
  .reduce<Map<string, number>>((counts, tag) => {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
    return counts;
  }, new Map());
const tags = [...tagCounts.entries()].sort(([a], [b]) => a.localeCompare(b));
---

<BaseLayout locale={locale} title={label} description={sectionCopy.description}>
  <SectionHeader
    eyebrow={sectionCopy.eyebrow}
    title={sectionCopy.title}
    description={sectionCopy.description}
  />
  {
    tags.length > 0 && (
      <nav class="tag-cloud" aria-label={`${label} tags`}>
        {tags.map(([tag, count]) => (
          <span class="tag-cloud__item">
            {tag}
            <small>{count}</small>
          </span>
        ))}
      </nav>
    )
  }
  <section class={gridClass} aria-label={`${label} entries`}>
    {
      entries.map((entry) => (
        <ContentCard
          href={withLocale(`/${collection}/${entry.slug}/`, locale)}
          title={entry.data.title}
          summary={entry.data.summary}
          date={entry.data.date}
          tags={getEntryTags(entry)}
        />
      ))
    }
  </section>
</BaseLayout>
