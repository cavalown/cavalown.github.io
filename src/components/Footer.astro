---
import { copy, defaultLocale, type Locale } from "@data/i18n";

interface Props {
  locale?: Locale;
}

const { locale = defaultLocale } = Astro.props;
const year = new Date().getFullYear();
const email = "cavalown@gmail.com";
---

<footer class="site-footer">
  <a class="site-footer__email" href={`mailto:${email}`}>{email}</a>
  <p class="site-footer__note">{copy[locale].footer}</p>
  <p class="site-footer__copyright">&copy; {year} cavalown</p>
</footer>
