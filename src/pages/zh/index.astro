---
import { copy, withLocale } from "@data/i18n";
import HeroSocialLinks from "@components/HeroSocialLinks.astro";
import BaseLayout from "@layouts/BaseLayout.astro";
import { navItems } from "@data/site";

const locale = "zh";
---

<BaseLayout locale={locale}>
  <section class="hero" aria-labelledby="hero-title">
    <h1 id="hero-title">{copy[locale].hero.title}</h1>
    <p class="hero__lede">{copy[locale].hero.lede}</p>
    <img
      class="hero__portrait"
      src="/images/me.png"
      alt=""
      width="1086"
      height="1448"
      decoding="async"
    />
    <HeroSocialLinks />
    <div class="hero__actions" aria-label="Primary sections">
      {
        navItems.map((item) => (
          <a class="pill-link" href={withLocale(item.href, locale)}>
            {copy[locale].nav[item.key]}
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
