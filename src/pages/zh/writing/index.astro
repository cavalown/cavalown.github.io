---
import ContentCard from "@components/ContentCard.astro";
import { copy, withLocale } from "@data/i18n";
import BaseLayout from "@layouts/BaseLayout.astro";
import SectionHeader from "@components/SectionHeader.astro";
import { getCollection } from "astro:content";

const locale = "zh";
const writing = (await getCollection("writing")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout
  locale={locale}
  title={copy[locale].nav.writing}
  description={copy[locale].sections.writing.description}
>
  <SectionHeader
    eyebrow={copy[locale].sections.writing.eyebrow}
    title={copy[locale].sections.writing.title}
    description={copy[locale].sections.writing.description}
  />
  <section class="content-grid" aria-label="Writing entries">
    {
      writing.map((entry) => (
        <ContentCard
          href={withLocale(`/writing/${entry.slug}/`, locale)}
          title={entry.data.title}
          summary={entry.data.summary}
          date={entry.data.date}
          tags={[entry.data.kind, ...entry.data.tags]}
        />
      ))
    }
  </section>
</BaseLayout>
