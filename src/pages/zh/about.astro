---
import { copy } from "@data/i18n";
import BaseLayout from "@layouts/BaseLayout.astro";
import SectionHeader from "@components/SectionHeader.astro";

const locale = "zh";
---

<BaseLayout
  locale={locale}
  title={copy[locale].nav.about}
  description={copy[locale].about.description}
>
  <section class="split-section">
    <SectionHeader
      eyebrow="About"
      title={copy[locale].about.title}
      description={copy[locale].about.description}
    />
    <div class="prose">
      <p>{copy[locale].about.intro}</p>
      <p>{copy[locale].about.body}</p>
      <h2>{copy[locale].about.heading}</h2>
      <p>{copy[locale].about.outro}</p>
    </div>
  </section>
</BaseLayout>
