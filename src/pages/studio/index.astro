---
import ContentCard from "@components/ContentCard.astro";
import { copy } from "@data/i18n";
import BaseLayout from "@layouts/BaseLayout.astro";
import SectionHeader from "@components/SectionHeader.astro";
import { getCollection } from "astro:content";

const locale = "en";
const notes = (await getCollection("studio")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout
  locale={locale}
  title="Studio"
  description="Studio notes on making software, interfaces, and small systems."
>
  <SectionHeader
    eyebrow={copy[locale].sections.studio.eyebrow}
    title={copy[locale].sections.studio.title}
    description={copy[locale].sections.studio.description}
  />
  <section class="content-grid" aria-label="Studio entries">
    {
      notes.map((entry) => (
        <ContentCard
          href={`/studio/${entry.slug}/`}
          title={entry.data.title}
          summary={entry.data.summary}
          date={entry.data.date}
          tags={[entry.data.kind, ...entry.data.tags]}
        />
      ))
    }
  </section>
</BaseLayout>
